# Base de datos
POSTGRES_USER=mining
POSTGRES_PASSWORD=mining_dev_password
POSTGRES_DB=mining_manager
DATABASE_URL="postgresql://mining:mining_dev_password@localhost:5432/mining_manager?schema=public"

# Backend
PORT=3001
JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000

# Almacenamiento S3 compatible (dejar vacío para usar almacenamiento local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mining-manager
S3_PUBLIC_URL=http://localhost:9000/mining-manager
UPLOAD_DIR=./uploads

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
